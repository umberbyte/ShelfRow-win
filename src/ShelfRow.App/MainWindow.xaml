<Window
    x:Class="ShelfRow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShelfRow.App.ViewModels"
    xmlns:core="using:ShelfRow.Core.Models"
    mc:Ignorable="d"
    Title="ShelfRow">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main 3-Pane Body -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Sidebar -->
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="195" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <!-- Center Pane: Main Content -->
                <ColumnDefinition Width="*" MinWidth="540" />
                <ColumnDefinition Width="Auto" />
                <!-- Right Pane: Inspector / Detail -->
                <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="240" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- =================================================================== -->
            <!-- 1. LEFT PANE: SIDEBAR                                              -->
            <!-- =================================================================== -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel x:Name="SidebarHeader" Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="18,16,18,12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE82D;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="ShelfRow" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Sidebar Navigation List -->
                <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" Padding="8,0,8,8">
                    <StackPanel Spacing="16">
                        <!-- Section: Library -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="ライブラリ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,4,12,4" />
                            
                            <Button x:Name="BtnAllBooks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8" Click="AllBooks_Click" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="すべての項目" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TotalBooksCountText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="BtnUnreadBooks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8" Click="UnreadBooks_Click" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xEA3B;" FontSize="12" Foreground="#22C55E" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="未読" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Section: Favorites (Static Shelves) -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="お気に入り" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,4,12,4" />
                            
                            <ListView ItemsSource="{x:Bind ViewModel.StaticShelves, Mode=OneWay}" SelectionMode="Single" SelectionChanged="Shelf_SelectionChanged" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:Shelf">
                                        <Grid Padding="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8F1;" FontSize="14" Margin="0,0,8,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="名前を変更..." Click="EditStandardShelf_Click" Tag="{x:Bind}" />
                                                    <MenuFlyoutItem Text="削除" Click="DeleteShelf_Click" Tag="{x:Bind}" />
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Section: Smart Shelves -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="スマートシェルフ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,4,12,4" />
                            
                            <ListView ItemsSource="{x:Bind ViewModel.SmartShelves, Mode=OneWay}" SelectionMode="Single" SelectionChanged="Shelf_SelectionChanged" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:Shelf">
                                        <Grid Padding="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE734;" FontSize="14" Margin="0,0,8,0" Foreground="#EAB308" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="編集..." Click="EditSmartShelf_Click" Tag="{x:Bind}" />
                                                    <MenuFlyoutItem Text="削除" Click="DeleteShelf_Click" Tag="{x:Bind}" />
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer Controls -->
                <Grid x:Name="SidebarFooter" Grid.Row="2" Padding="12,8" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button ToolTipService.ToolTip="シェルフを追加">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="新規標準シェルフ..." Click="NewStandardShelf_Click" />
                                    <MenuFlyoutItem Text="新規スマートシェルフ..." Click="NewSmartShelf_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Click="SettingsButton_Click" ToolTipService.ToolTip="環境設定">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Splitter 1 -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- =================================================================== -->
            <!-- 2. CENTER PANE: MAIN CONTENT                                       -->
            <!-- =================================================================== -->
            <Grid Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header & Filter Controls -->
                <StackPanel Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <!-- Row 1: Collection Title, Mode Switcher, Sort, Search -->
                    <Grid x:Name="TopHeader" Padding="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Collection Title & Items Count -->
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentCollectionTitle, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.ItemsCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Center / Right: View Mode, Sort, Search -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- View Mode Switcher (List / Grid) -->
                            <StackPanel Orientation="Horizontal" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                <Button Content="リスト" Click="ViewModeList_Click"
                                        Background="{x:Bind ViewModel.ListViewModeBackground, Mode=OneWay}"
                                        Padding="10,4" BorderThickness="0" CornerRadius="4" FontSize="12" />
                                <Button Content="グリッド" Click="ViewModeGrid_Click"
                                        Background="{x:Bind ViewModel.GridViewModeBackground, Mode=OneWay}"
                                        Padding="10,4" BorderThickness="0" CornerRadius="4" FontSize="12" />
                            </StackPanel>

                            <!-- Sort Menu -->
                            <Button Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.SortKeyLabel, Mode=OneWay}" FontSize="12" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="タイトルで並び替え" Click="SortByTitle_Click" />
                                        <MenuFlyoutItem Text="レートで並び替え" Click="SortByRating_Click" />
                                        <MenuFlyoutItem Text="作者で並び替え" Click="SortByAuthor_Click" />
                                        <MenuFlyoutItem Text="登録日で並び替え" Click="SortByAddedDate_Click" />
                                        <MenuFlyoutItem Text="ページ数で並び替え" Click="SortByPages_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="昇順 / 降順を切り替え" Click="ToggleSortDirection_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Search Box -->
                            <AutoSuggestBox Width="240"
                                            PlaceholderText="検索..."
                                            QueryIcon="Find"
                                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Live Filters (Unread, Type, Rating, Clear) -->
                    <StackPanel x:Name="FilterPanel" Spacing="8" Padding="20,0,20,12">
                        <!-- Line 1: Unread & Book Types -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Unread Filter -->
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsUnreadOnlyFilter, Mode=TwoWay}" Padding="8,4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" />
                                    <TextBlock Text="未読" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </ToggleButton>

                            <Border Width="1" Height="18" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                            <TextBlock Text="種別:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />

                            <ToggleButton Content="すべて" IsChecked="{x:Bind ViewModel.IsTypeFilterAll, Mode=OneWay}"
                                          Click="FilterTypeAll_Click" Padding="8,3" FontSize="12" CornerRadius="4" />
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsType0Selected, Mode=OneWay}"
                                          Click="FilterType0_Click" Padding="8,3" FontSize="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="#EAB308" />
                                    <TextBlock Text="{x:Bind ViewModel.TypeName0, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsType1Selected, Mode=OneWay}"
                                          Click="FilterType1_Click" Padding="8,3" FontSize="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="#3B82F6" />
                                    <TextBlock Text="{x:Bind ViewModel.TypeName1, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsType2Selected, Mode=OneWay}"
                                          Click="FilterType2_Click" Padding="8,3" FontSize="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="#22C55E" />
                                    <TextBlock Text="{x:Bind ViewModel.TypeName2, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsType3Selected, Mode=OneWay}"
                                          Click="FilterType3_Click" Padding="8,3" FontSize="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="#EC4899" />
                                    <TextBlock Text="{x:Bind ViewModel.TypeName3, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsType4Selected, Mode=OneWay}"
                                          Click="FilterType4_Click" Padding="8,3" FontSize="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="#9CA3AF" />
                                    <TextBlock Text="{x:Bind ViewModel.TypeName4, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton IsChecked="{x:Bind ViewModel.IsType5Selected, Mode=OneWay}"
                                          Click="FilterType5_Click" Padding="8,3" FontSize="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="12" Foreground="#A855F7" />
                                    <TextBlock Text="{x:Bind ViewModel.TypeName5, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <!-- Line 2: Rating Stars & Clear -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="評価:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ToggleButton Content="★1" IsChecked="{x:Bind ViewModel.IsRating1Selected, Mode=OneWay}"
                                              Click="FilterRating1_Click" Padding="6,2" FontSize="12" CornerRadius="4" />
                                <ToggleButton Content="★2" IsChecked="{x:Bind ViewModel.IsRating2Selected, Mode=OneWay}"
                                              Click="FilterRating2_Click" Padding="6,2" FontSize="12" CornerRadius="4" />
                                <ToggleButton Content="★3" IsChecked="{x:Bind ViewModel.IsRating3Selected, Mode=OneWay}"
                                              Click="FilterRating3_Click" Padding="6,2" FontSize="12" CornerRadius="4" />
                                <ToggleButton Content="★4" IsChecked="{x:Bind ViewModel.IsRating4Selected, Mode=OneWay}"
                                              Click="FilterRating4_Click" Padding="6,2" FontSize="12" CornerRadius="4" />
                                <ToggleButton Content="★5" IsChecked="{x:Bind ViewModel.IsRating5Selected, Mode=OneWay}"
                                              Click="FilterRating5_Click" Padding="6,2" FontSize="12" CornerRadius="4" />
                            </StackPanel>

                            <Button Content="フィルタをクリア" Click="ClearFilters_Click" HorizontalAlignment="Right" Padding="10,3" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Content Area: List View or Grid View -->
                <Grid Grid.Row="1">
                    <!-- Loading Indicator -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Canvas.ZIndex="10" />

                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="該当する本がありません" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- GRID VIEW MODE (Matching mac GridItemCardView) -->
                    <!--
                        Not wrapped in a ScrollViewer: GridView brings its own, and an
                        outer one gives it unlimited height, which turns virtualization
                        off and makes it build a card for every book in the library at
                        once.
                    -->
                    <GridView x:Name="BookGridView"
                                  Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
                                  Padding="20,16"
                                  ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="False"
                                  DoubleTapped="BookList_DoubleTapped">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="130" ItemHeight="195" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>

                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ItemViewModel">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center" Width="110" Padding="0,4">
                                        <StackPanel.ContextFlyout>
                                            <MenuFlyout Opening="BookContextFlyout_Opening" />
                                        </StackPanel.ContextFlyout>
                                        <!-- Cover Image (110x145, 4px CornerRadius) -->
                                        <Border Width="110" Height="145" CornerRadius="4"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill" />
                                                
                                                <!-- Unread Indicator (Top Right Dot) -->
                                                <Ellipse Width="10" Height="10" Fill="#22C55E"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                                         Margin="6" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <!-- 2-Line Centered Title -->
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Height="28"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                    </GridView>

                    <!-- LIST VIEW MODE (Matching mac classicListRow) -->
                    <ListView x:Name="BookListView"
                              Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              Padding="12,8"
                              DoubleTapped="BookList_DoubleTapped">
                        <ListView.Header>
                            <Grid Padding="12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="ColumnMenu_Opening">
                                        <ToggleMenuFlyoutItem Text="未読" Tag="unread" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="種類" Tag="bookType" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="タイトル" Tag="title" IsChecked="True" IsEnabled="False" />
                                        <ToggleMenuFlyoutItem Text="レート" Tag="rating" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="作者" Tag="author" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="ジャンル" Tag="genre" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="関連" Tag="relation" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="キーワードA" Tag="keywordA" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="キーワードB" Tag="keywordB" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="読んだ日" Tag="lastReadDate" Click="ToggleColumnVisibility_Click" />
                                        <ToggleMenuFlyoutItem Text="登録日" Tag="addedDate" Click="ToggleColumnVisibility_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.Resources>
                                    <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button">
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="Padding" Value="0,2" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="CornerRadius" Value="3" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot0Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot1Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot2Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot3Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot4Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot5Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot6Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot7Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot8Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot9Width, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ViewModel.ListLayout.Slot10Width, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.UnreadColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.UnreadVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.UnreadSortHeader, Mode=OneWay}" Click="SortByUnread_Click" Tag="unread"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.BookTypeColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.BookTypeVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.BookTypeSortHeader, Mode=OneWay}" Click="SortByBookType_Click" Tag="bookType"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.TitleColumn, Mode=OneWay}" Style="{StaticResource ColumnHeaderButtonStyle}"
                                        Content="{x:Bind ViewModel.TitleSortHeader, Mode=OneWay}" Click="SortByTitle_Click" Tag="title"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.RatingColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.RatingVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.RatingSortHeader, Mode=OneWay}" Click="SortByRating_Click" Tag="rating"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.AuthorColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.AuthorVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.AuthorSortHeader, Mode=OneWay}" Click="SortByAuthor_Click" Tag="author"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.GenreColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.GenreVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.GenreSortHeader, Mode=OneWay}" Click="SortByGenre_Click" Tag="genre"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.RelationColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.RelationVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.RelationSortHeader, Mode=OneWay}" Click="SortByRelation_Click" Tag="relation"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.KeywordAColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.KeywordAVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.KeywordASortHeader, Mode=OneWay}" Click="SortByKeywordA_Click" Tag="keywordA"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.KeywordBColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.KeywordBVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.KeywordBSortHeader, Mode=OneWay}" Click="SortByKeywordB_Click" Tag="keywordB"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.LastReadDateColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.LastReadDateVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.LastReadDateSortHeader, Mode=OneWay}" Click="SortByLastReadDate_Click" Tag="lastReadDate"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <Button Grid.Column="{x:Bind ViewModel.ListLayout.AddedDateColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.AddedDateVisibility, Mode=OneWay}"
                                        Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind ViewModel.AddedDateSortHeader, Mode=OneWay}" Click="SortByAddedDate_Click" Tag="addedDate"
                                        CanDrag="True" AllowDrop="True" DragStarting="ColumnHeader_DragStarting" DragOver="ColumnHeader_DragOver" Drop="ColumnHeader_Drop" />
                                <!-- Resizable-column grips. Widths are persisted in logical (unscaled) pixels. -->
                                <Border Grid.Column="{x:Bind ViewModel.ListLayout.TitleColumn, Mode=OneWay}" Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="title" Canvas.ZIndex="2"
                                        PointerPressed="ColumnResize_PointerPressed" PointerMoved="ColumnResize_PointerMoved" PointerReleased="ColumnResize_PointerReleased" PointerCanceled="ColumnResize_PointerCanceled" ToolTipService.ToolTip="ドラッグして列幅を変更" />
                                <Border Grid.Column="{x:Bind ViewModel.ListLayout.AuthorColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.AuthorVisibility, Mode=OneWay}" Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="author" Canvas.ZIndex="2"
                                        PointerPressed="ColumnResize_PointerPressed" PointerMoved="ColumnResize_PointerMoved" PointerReleased="ColumnResize_PointerReleased" PointerCanceled="ColumnResize_PointerCanceled" ToolTipService.ToolTip="ドラッグして列幅を変更" />
                                <Border Grid.Column="{x:Bind ViewModel.ListLayout.GenreColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.GenreVisibility, Mode=OneWay}" Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="genre" Canvas.ZIndex="2"
                                        PointerPressed="ColumnResize_PointerPressed" PointerMoved="ColumnResize_PointerMoved" PointerReleased="ColumnResize_PointerReleased" PointerCanceled="ColumnResize_PointerCanceled" ToolTipService.ToolTip="ドラッグして列幅を変更" />
                                <Border Grid.Column="{x:Bind ViewModel.ListLayout.RelationColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.RelationVisibility, Mode=OneWay}" Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="relation" Canvas.ZIndex="2"
                                        PointerPressed="ColumnResize_PointerPressed" PointerMoved="ColumnResize_PointerMoved" PointerReleased="ColumnResize_PointerReleased" PointerCanceled="ColumnResize_PointerCanceled" ToolTipService.ToolTip="ドラッグして列幅を変更" />
                                <Border Grid.Column="{x:Bind ViewModel.ListLayout.KeywordAColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.KeywordAVisibility, Mode=OneWay}" Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="keywordA" Canvas.ZIndex="2"
                                        PointerPressed="ColumnResize_PointerPressed" PointerMoved="ColumnResize_PointerMoved" PointerReleased="ColumnResize_PointerReleased" PointerCanceled="ColumnResize_PointerCanceled" ToolTipService.ToolTip="ドラッグして列幅を変更" />
                                <Border Grid.Column="{x:Bind ViewModel.ListLayout.KeywordBColumn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ListLayout.KeywordBVisibility, Mode=OneWay}" Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="keywordB" Canvas.ZIndex="2"
                                        PointerPressed="ColumnResize_PointerPressed" PointerMoved="ColumnResize_PointerMoved" PointerReleased="ColumnResize_PointerReleased" PointerCanceled="ColumnResize_PointerCanceled" ToolTipService.ToolTip="ドラッグして列幅を変更" />
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemViewModel">
                                <Grid Padding="6,4">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="BookContextFlyout_Opening" />
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot0Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot1Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot2Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot3Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot4Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot5Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot6Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot7Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot8Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot9Width, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ListLayout.Slot10Width, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Unread Circle -->
                                    <Ellipse Grid.Column="{x:Bind ListLayout.UnreadColumn}" Width="8" Height="8" Stroke="#22C55E" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />

                                    <!-- Book Type Icon -->
                                    <FontIcon Grid.Column="{x:Bind ListLayout.BookTypeColumn}" Visibility="{x:Bind ListLayout.BookTypeVisibility, Mode=OneWay}" Glyph="{x:Bind BookTypeGlyph, Mode=OneWay}"
                                              Foreground="{x:Bind BookTypeBrush, Mode=OneWay}"
                                              FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Title -->
                                    <TextBlock Grid.Column="{x:Bind ListLayout.TitleColumn}" Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <!-- Rating Stars: directly editable, matching the inspector. -->
                                    <RatingControl Grid.Column="{x:Bind ListLayout.RatingColumn}" Visibility="{x:Bind ListLayout.RatingVisibility, Mode=OneWay}" Value="{x:Bind RatingValue, Mode=TwoWay}"
                                                   MaxRating="5" IsClearEnabled="True" HorizontalAlignment="Left"
                                                   Loaded="EditableRating_Loaded" Unloaded="EditableRating_Unloaded">
                                        <RatingControl.Resources>
                                            <SolidColorBrush x:Key="RatingControlSelectedForeground" Color="#EAB308" />
                                            <SolidColorBrush x:Key="RatingControlPointerOverSelectedForeground" Color="#FACC15" />
                                            <SolidColorBrush x:Key="RatingControlPlaceholderForeground" Color="#EAB308" />
                                            <SolidColorBrush x:Key="RatingControlPointerOverPlaceholderForeground" Color="#FACC15" />
                                        </RatingControl.Resources>
                                    </RatingControl>

                                    <!-- Author -->
                                    <TextBlock Grid.Column="{x:Bind ListLayout.AuthorColumn}" Visibility="{x:Bind ListLayout.AuthorVisibility, Mode=OneWay}" Text="{x:Bind Author, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <!-- Genre -->
                                    <TextBlock Grid.Column="{x:Bind ListLayout.GenreColumn}" Visibility="{x:Bind ListLayout.GenreVisibility, Mode=OneWay}" Text="{x:Bind Genre, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <!-- Added Date -->
                                    <TextBlock Grid.Column="{x:Bind ListLayout.RelationColumn}" Visibility="{x:Bind ListLayout.RelationVisibility, Mode=OneWay}" Text="{x:Bind Relation, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{x:Bind ListLayout.KeywordAColumn}" Visibility="{x:Bind ListLayout.KeywordAVisibility, Mode=OneWay}" Text="{x:Bind KeywordA, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{x:Bind ListLayout.KeywordBColumn}" Visibility="{x:Bind ListLayout.KeywordBVisibility, Mode=OneWay}" Text="{x:Bind KeywordB, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{x:Bind ListLayout.LastReadDateColumn}" Visibility="{x:Bind ListLayout.LastReadDateVisibility, Mode=OneWay}" Text="{x:Bind LastReadDateListText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="{x:Bind ListLayout.AddedDateColumn}" Visibility="{x:Bind ListLayout.AddedDateVisibility, Mode=OneWay}" Text="{x:Bind AddedDateListText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Splitter 2 -->
            <Border Grid.Column="3" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- =================================================================== -->
            <!-- 3. RIGHT PANE: INSPECTOR / DETAIL (Matching mac classicInspectorView) -->
            <!-- =================================================================== -->
            <Grid Grid.Column="4" Background="{ThemeResource LayerFillColorAltBrush}">
                <!-- Empty selection state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.NoSelectedItem, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8EC;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="本棚から本を選択してください。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Selected item inspector view -->
                <ScrollViewer x:Name="InspectorScroll" Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}" Padding="16,20,16,24">
                    <StackPanel Spacing="14">
                        <!-- Big Cover Image (176x224, 10px CornerRadius, Shadow) -->
                        <Border Width="176" Height="224" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Grid>
                                <FontIcon Glyph="&#xE82D;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.SelectedItem.ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Button Content="表紙を編集..." Click="EditCover_Click" HorizontalAlignment="Center" />

                        <!-- Item Title (18pt bold, max 2 lines) -->
                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.Title, Mode=OneWay}"
                                   FontSize="17" FontWeight="Bold" MaxLines="2" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center" />

                        <!-- Unread Checkbox -->
                        <CheckBox Content="未読にする"
                                  IsChecked="{x:Bind ViewModel.SelectedItem.IsUnread, Mode=TwoWay}"
                                  HorizontalAlignment="Center" />

                        <MenuFlyoutSeparator />

                        <!-- Metadata Fields (Right-aligned 78px label + Edit Box) -->
                        <StackPanel Spacing="8">
                            <!-- Title -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="タイトル:" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Title, Mode=TwoWay}" FontSize="12" Tag="Title" GotFocus="InspectorTextBox_GotFocus" />
                            </Grid>

                            <!-- Author -->
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.AuthorFieldLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Author, Mode=TwoWay}" FontSize="12" Tag="Author" GotFocus="InspectorTextBox_GotFocus" />
                                </Grid>
                                <Button Margin="86,0,0,0" Padding="8,2" FontSize="11" Click="SearchAuthorKeyword_Click"
                                        Content="{x:Bind ViewModel.SearchAuthorLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedItem.AuthorVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Rating -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="レート:" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <!--
                                    Bound to RatingValue, not Rating: RatingControl uses
                                    -1 for "no rating" and rounds a 0 up to 1, writing
                                    that back, so selecting an unrated book gave it a star.
                                -->
                                <RatingControl x:Name="InspectorRatingControl" Grid.Column="1"
                                               Value="{x:Bind ViewModel.SelectedItem.RatingValue, Mode=TwoWay}"
                                               MaxRating="5" IsClearEnabled="True" HorizontalAlignment="Left">
                                    <RatingControl.Resources>
                                        <SolidColorBrush x:Key="RatingControlSelectedForeground" Color="#EAB308" />
                                        <SolidColorBrush x:Key="RatingControlPointerOverSelectedForeground" Color="#FACC15" />
                                        <SolidColorBrush x:Key="RatingControlPlaceholderForeground" Color="#EAB308" />
                                        <SolidColorBrush x:Key="RatingControlPointerOverPlaceholderForeground" Color="#FACC15" />
                                    </RatingControl.Resources>
                                </RatingControl>
                            </Grid>

                            <!-- Keyword A -->
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.KeywordAFieldLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.KeywordA, Mode=TwoWay}" FontSize="12" Tag="KeywordA" GotFocus="InspectorTextBox_GotFocus" />
                                </Grid>
                                <Button Margin="86,0,0,0" Padding="8,2" FontSize="11" Click="SearchKeywordA_Click"
                                        Content="{x:Bind ViewModel.SearchKeywordALabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedItem.KeywordAVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Keyword B -->
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.KeywordBFieldLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.KeywordB, Mode=TwoWay}" FontSize="12" Tag="KeywordB" GotFocus="InspectorTextBox_GotFocus" />
                                </Grid>
                                <Button Margin="86,0,0,0" Padding="8,2" FontSize="11" Click="SearchKeywordB_Click"
                                        Content="{x:Bind ViewModel.SearchKeywordBLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedItem.KeywordBVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Memo -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="メモ:" FontSize="12" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Memo, Mode=TwoWay}" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="70" Tag="Memo" GotFocus="InspectorTextBox_GotFocus" />
                            </Grid>

                            <!-- Genre -->
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.GenreFieldLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Genre, Mode=TwoWay}" FontSize="12" Tag="Genre" GotFocus="InspectorTextBox_GotFocus" />
                                </Grid>
                                <Button Margin="86,0,0,0" Padding="8,2" FontSize="11" Click="SearchGenreKeyword_Click"
                                        Content="{x:Bind ViewModel.SearchGenreLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedItem.GenreVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Relation -->
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.RelationFieldLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Relation, Mode=TwoWay}" FontSize="12" Tag="Relation" GotFocus="InspectorTextBox_GotFocus" />
                                </Grid>
                                <Button Margin="86,0,0,0" Padding="8,2" FontSize="11" Click="SearchRelationKeyword_Click"
                                        Content="{x:Bind ViewModel.SearchRelationLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedItem.RelationVisibility, Mode=OneWay}" />
                            </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="スタンプ:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="編集" HorizontalAlignment="Right" Padding="6,1" FontSize="11" Click="EditStamps_Click" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Stamps, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Tag="{Binding}" Click="Stamp_Click" Padding="7,3" Margin="0,0,4,4" FontSize="10" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        <MenuFlyoutSeparator />

                        <!-- Read-only Metadata Footer (Added date, last read, pages) -->
                        <StackPanel Spacing="3" Margin="8,0">
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.AddedDateText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.LastReadDateText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.PagesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="1" Padding="16,6,16,6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalBooksCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="LockOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Canvas.ZIndex="1000">
            <StackPanel Width="280" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="ShelfRowはロックされています。" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <PasswordBox x:Name="LockPasswordBox" PlaceholderText="パスワードを入力してください"
                             KeyDown="LockPasswordBox_KeyDown" PasswordChanged="LockPasswordBox_PasswordChanged" />
                <TextBlock x:Name="LockErrorText" Text="パスワードが正しくありません。"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                           HorizontalAlignment="Center" />
                <Button Content="OK" Click="Unlock_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
