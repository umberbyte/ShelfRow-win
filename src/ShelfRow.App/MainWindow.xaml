<Window
    x:Class="ShelfRow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShelfRow.App.ViewModels"
    mc:Ignorable="d"
    Title="ShelfRow">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command Bar / Top Toolbar -->
        <Grid Grid.Row="0" Padding="16,10,16,10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="ShelfRow" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search Bar -->
            <AutoSuggestBox Grid.Column="1"
                            Margin="32,0,32,0"
                            MaxWidth="480"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="タイトル・著者名で検索..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="ImportXmlButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                        ToolTipService.ToolTip="Stackroom Library.xml からインポート">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="XMLインポート" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.SyncCommand, Mode=OneWay}" ToolTipService.ToolTip="CloudKitと同期">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="同期" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsButton_Click" ToolTipService.ToolTip="NAS ボリューム設定">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Navigation Sidebar + Book Grid -->
        <NavigationView Grid.Row="1"
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        ItemInvoked="NavView_ItemInvoked"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="すべての書籍" Tag="all_books">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="本棚" />
            </NavigationView.MenuItems>

            <!-- Grid of Books (Virtualized) -->
            <Grid Padding="20,16,20,16">
                <!-- Loading Ring -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Canvas.ZIndex="10" />

                <!-- Empty State Message -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE736;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="表示する書籍がありません"
                               FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Book Grid with UI Virtualization -->
                <GridView ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="GridView_ItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" ItemHeight="260" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemViewModel">
                            <Grid Padding="6" CornerRadius="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Cover Image Container -->
                                <Border Grid.Row="0"
                                        CornerRadius="6"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <!-- Placeholder when thumbnail is loading/absent -->
                                        <FontIcon Glyph="&#xE82D;"
                                                  FontSize="36"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                        <!-- Actual Thumbnail Image -->
                                        <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                                               Stretch="UniformToFill" />

                                        <!-- Unread Badge -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="6"
                                                Padding="6,2"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind IsUnread, Mode=OneWay}">
                                            <TextBlock Text="未読" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Title -->
                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,6,2,0" />

                                <!-- Author -->
                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind Author, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,2,2,0" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </NavigationView>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Padding="16,6,16,6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.TotalBooksCountText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Import Progress Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Canvas.ZIndex="999"
              Visibility="{x:Bind ViewModel.ImportOverlayVisibility, Mode=OneWay}">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}" Width="24" Height="24" />
                        <TextBlock Text="Stackroom XML インポート中" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Text="{x:Bind ViewModel.ImportProgressText, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
