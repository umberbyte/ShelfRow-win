<ContentDialog
    x:Class="ShelfRow.App.Views.VolumeSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShelfRow.App.ViewModels"
    mc:Ignorable="d"
    Title="NAS ボリューム設定とパス割り当て"
    PrimaryButtonText="保存して閉じる"
    DefaultButton="Primary"
    CloseButtonText="キャンセル">

    <ContentDialog.Resources>
        <!--
            A ContentDialog is capped at 548px by default, which cut off the Windows path
            field and the thumbnail button. The content sets no width of its own so it
            fills whatever these allow.
        -->
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">760</x:Double>
    </ContentDialog.Resources>

    <Grid MaxHeight="520" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0"
                   Text="macOS のマウントパス（例: /Volumes/Books）と Windows の実体パス（UNC \\NAS\Books または ドライブ Z:\）をマッピングします。"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16" />

        <!-- Empty State -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Padding="40">
            <FontIcon Glyph="&#xE838;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="管理されているボリュームがありません"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Stackroom XML をインポートすると、ここにボリュームが表示されます。"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Volume List -->
        <ScrollViewer x:Name="VolumeListScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="VolumeItemsRepeater">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:VolumeViewModel">
                        <Border Margin="0,0,0,12"
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Status dot + Volume name + Status text -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Indicator Dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="自動推定"
                                            FontSize="12"
                                            Padding="8,4"
                                            Tag="{x:Bind}"
                                            Click="AutoDetect_Click"
                                            ToolTipService.ToolTip="macOS パスから Windows パスを自動推定します" />
                                </Grid>

                                <!-- macOS Original Path -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="macOS パス:"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Width="85"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind LastKnownPath, Mode=OneWay}"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Windows Mount Path Input + Browse Button -->
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Windows パス:"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Width="85"
                                               VerticalAlignment="Center" />

                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind WindowsMountPath, Mode=TwoWay}"
                                             PlaceholderText="\\NAS\Books または Z:\Books"
                                             FontFamily="Consolas"
                                             FontSize="12" />

                                    <!--
                                        Tag carries the volume: ItemsRepeater does not
                                        reliably set DataContext on realized elements, and
                                        the handlers were silently dropping every click.
                                    -->
                                    <Button Grid.Column="2"
                                            Content="参照..."
                                            FontSize="12"
                                            Padding="10,5"
                                            Tag="{x:Bind}"
                                            Click="BrowseFolder_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Thumbnail Distribution Cache Sync Section -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="14"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="サムネイル共有キャッシュ (ShelfRowThumbnails)"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="NAS から未取得の書影画像をローカルへ一括同期します。"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button x:Name="SyncThumbnailsBtn"
                        Grid.Row="0" Grid.Column="1"
                        Content="サムネイルを一括同期"
                        Click="SyncThumbnails_Click" />

                <StackPanel x:Name="SyncProgressPanel"
                            Grid.Row="1" Grid.ColumnSpan="2"
                            Spacing="6"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock x:Name="SyncProgressStatusText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
