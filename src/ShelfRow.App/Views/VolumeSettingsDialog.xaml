<ContentDialog
    x:Class="ShelfRow.App.Views.VolumeSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShelfRow.App.ViewModels"
    mc:Ignorable="d"
    Title="NAS ボリューム設定とパス割り当て"
    PrimaryButtonText="保存して閉じる"
    DefaultButton="Primary"
    CloseButtonText="キャンセル">

    <Grid Width="580" MaxHeight="500" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0"
                   Text="macOS のマウントパス（例: /Volumes/Books）と Windows の実体パス（UNC \\NAS\Books または ドライブ Z:\）をマッピングします。"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16" />

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Padding="40"
                    Visibility="{x:Bind HasNoVolumes, Mode=OneWay}">
            <FontIcon Glyph="&#xE838;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="管理されているボリュームがありません"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Stackroom XML をインポートすると、ここにボリュームが表示されます。"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Volume List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind HasVolumes, Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind Volumes, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:VolumeViewModel">
                        <Border Margin="0,0,0,12"
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Status dot + Volume name + Status text -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Indicator Dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="自動推定"
                                            FontSize="12"
                                            Padding="8,4"
                                            Click="AutoDetect_Click"
                                            ToolTipService.ToolTip="macOS パスから Windows パスを自動推定します" />
                                </Grid>

                                <!-- macOS Original Path -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="macOS パス:"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Width="85"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind LastKnownPath, Mode=OneWay}"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Windows Mount Path Input + Browse Button -->
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Windows パス:"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Width="85"
                                               VerticalAlignment="Center" />

                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind WindowsMountPath, Mode=TwoWay}"
                                             PlaceholderText="\\NAS\Books または Z:\Books"
                                             FontFamily="Consolas"
                                             FontSize="12" />

                                    <Button Grid.Column="2"
                                            Content="参照..."
                                            FontSize="12"
                                            Padding="10,5"
                                            Click="BrowseFolder_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</ContentDialog>
